# Output project debugging information
verbose: false
logLevel: "INFO"

# The path to the local repository maven will use to store artifacts
#localRepository: "~/.m2/repository/org/antlr/"
localRepository: "~/.m2/repository"

push:
  # The URL of the nexus releases repository (releases only, optional)
  releaseUrl: "http://localhost:8081/repository/maven-releases"
  # The URL of the nexus snapshots repository (snapshots only, optional)
  snapshotsUrl: "http://localhost:8081/repository/maven-snapshots"
  # The URL of the nexus mixed repository (releases and snapshots, optional)
  # mixedUrl: "http://localhost:8081/repository/maven-mixed"
  # At least one of releaseUrl, snapshotsUrl or mixedUrl must be configured
  # Priority: releaseUrl > mixedUrl for releases; snapshotsUrl > mixedUrl for snapshots

  # Nexus authentication
  username: "admin"
  password: "admin123"
  # Number of parallel upload workers
  worker: 4

  # The list of file suffixes to be ignored
  excludeSuffixs:
    - ".DS_Store"
    - ".asc"
    - ".lastUpdated"
    - ".md5"
    - ".repositories"
    - ".sha1"
    - ".sha256"
    - ".sha512"
    - ".xml"

clean:
  # The list of file suffixes that will be cleaned up
  suffixs:
    - ".DS_Store"
    - ".lastUpdated"
  dirRegex:
    - "${*.version}"
